# Normalize line endings. Prevents the whole-repo CRLF churn that Windows
# editors/sync introduce. Git stores text as LF and checks out LF.
* text=auto eol=lf

# Documentation source — always LF
*.mdx  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.svg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets — never apply EOL conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
